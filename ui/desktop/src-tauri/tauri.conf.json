{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AAAI4S",
  "version": "0.0.0",
  "identifier": "com.zephyrxiang.aaai4s",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AAAI4S",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "create": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["splash"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/uv"],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "AAAI4S 科研平台",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.3"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzNjU0MzI3RTRFRUQxMDYKUldRRzBlN2tKME5sNDlSZzU3UTByV0o5RmUvSk8xUGZHRjlNZTRFYWlvVk1Od0FiVXhxWU5VTkIK",
      "endpoints": ["https://media.zephyrxiang.com/ai4science/dist/desktop/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
